{
  "name": "orbit-bazaar-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orbit Bazaar shop API — Express 5 + Postgres, serves the Angular bundle too.",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "migrate": "node -e \"import('./src/db/migrate.js').then(m=>m.runMigrations()).then(()=>process.exit(0))\"",
    "seed": "node -e \"import('./src/seed/seed-catalog.js').then(m=>m.seedCatalog({force:true})).then(()=>process.exit(0))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
