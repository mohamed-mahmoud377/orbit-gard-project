# Shop API — see CONTRACT.md §2.
PORT=4000
DATABASE_URL=postgres://orbit:orbit@db:5432/shop
# Maintenance DB used once at boot to CREATE DATABASE shop. Required on the
# server, where the Postgres volume predates this app so initdb never runs.
BOOTSTRAP_DATABASE_URL=postgres://orbit:orbit@db:5432/postgres
ORBIT_API_BASE=http://app:8080/api/v1
ORBIT_MERCHANT_NAME=Orbit Bazaar
ORBIT_TIMEOUT_MS=15000
JWT_SECRET=change-me
SEED_ON_BOOT=true
LOG_LEVEL=info
# Defaults to ../web/dist/web/browser
# SHOP_WEB_DIST=/app/web
