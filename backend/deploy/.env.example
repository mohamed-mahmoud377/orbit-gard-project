# Server environment variables (/root/orbit/.env)
#
# Copy to the server as /root/orbit/.env and fill in secrets.
# docker-compose.yml reads these values at runtime.

# Required — database password for the orbit Postgres user
POSTGRES_PASSWORD=

# Optional — injected automatically by GitHub Actions on deploy.
# For manual deploys, set these to the exact GHCR tags you want to run:
# APP_IMAGE=ghcr.io/mohamed-mahmoud377/orbit-gard-project:backend-<sha>
# WEB_IMAGE=ghcr.io/mohamed-mahmoud377/orbit-gard-project:frontend-<sha>

# Reserved for auth API rollout (uncomment when backend auth branch merges):
# JWT_SECRET=
# MAIL_HOST=
# MAIL_USER=
# MAIL_PASSWORD=
